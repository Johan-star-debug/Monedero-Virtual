<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uniquindio.edu.co.poo.monedero_virtual.ViewController.NotificacionesViewController"
            prefWidth="900" prefHeight="620"
            style="-fx-background-color: #F3F6FB;">

    <top>
        <VBox spacing="12" style="-fx-background-color: #183153;">
            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>

            <Button text="← Volver al menú"
                    onAction="#volverMenu"
                    prefWidth="160" prefHeight="38"
                    style="-fx-background-color: #315477; -fx-text-fill: white; -fx-background-radius: 8;"/>

            <Label text="NOTIFICACIONES"
                   style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Label text="Mantente informado sobre la actividad de tu monedero"
                   style="-fx-text-fill: #DCE8F5;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="18">
            <padding>
                <Insets top="30" right="35" bottom="30" left="35"/>
            </padding>

            <Label text="Tus notificaciones"
                   style="-fx-font-size: 21px; -fx-font-weight: bold;"/>

            <ListView fx:id="listaNotificaciones"
                      VBox.vgrow="ALWAYS"/>

            <Button text="Actualizar notificaciones"
                    onAction="#actualizarNotificaciones"
                    maxWidth="Infinity"
                    prefHeight="42"/>

        </VBox>
    </center>

</BorderPane>