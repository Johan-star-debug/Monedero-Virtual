
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="uniquindio.edu.co.poo.monedero_virtual.ViewController.ReportesViewController"
      spacing="15" alignment="CENTER"
      prefWidth="700" prefHeight="500">

    <Label text="REPORTES Y ANÁLISIS"
           style="-fx-font-size: 25px; -fx-font-weight: bold;"/>

    <Button text="Calcular gastos totales"
            onAction="#calcularGastos"/>

    <Button text="Consultar promedio de gastos"
            onAction="#consultarPromedio"/>

    <TextArea fx:id="txtReporte"
              editable="false"
              prefWidth="550"
              prefHeight="300"
              promptText="Los resultados aparecerán aquí."/>

</VBox>

