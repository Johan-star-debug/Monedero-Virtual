<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uniquindio.edu.co.poo.monedero_virtual.ViewController.TransaccionViewController"
            prefWidth="900" prefHeight="650"
            style="-fx-background-color: #F3F6FB;">

    <top>
        <VBox style="-fx-background-color: #183153;">
            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>
            <Label text="TRANSACCIONES"
                   style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Realiza depósitos, retiros y transferencias"
                   style="-fx-text-fill: #DCE8F5;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="16">
            <padding>
                <Insets top="30" right="45" bottom="30" left="45"/>
            </padding>

            <Label text="Nueva operación"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <Label text="Tipo de transacción"/>
            <ComboBox fx:id="cmbTipoTransaccion"
                      promptText="Selecciona una operación"
                      maxWidth="Infinity">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Depósito"/>
                        <String fx:value="Retiro"/>
                        <String fx:value="Transferencia"/>
                    </FXCollections>
                </items>
            </ComboBox>

            <Label text="Monedero de origen"/>
            <ComboBox fx:id="cmbOrigen"
                      promptText="Selecciona el monedero de origen"
                      maxWidth="Infinity"/>

            <Label text="Monedero de destino (para transferencias)"/>
            <ComboBox fx:id="cmbDestino"
                      promptText="Selecciona el monedero de destino"
                      maxWidth="Infinity"/>

            <Label text="Monto de la operación"/>
            <TextField fx:id="txtMonto"
                       promptText="Ingresa el monto"
                       maxWidth="Infinity"/>

            <Button text="Procesar transacción"
                    onAction="#procesarTransaccion"
                    prefHeight="45"
                    maxWidth="Infinity"/>

            <Label fx:id="lblMensaje"
                   wrapText="true"/>
        </VBox>
    </center>
</BorderPane>