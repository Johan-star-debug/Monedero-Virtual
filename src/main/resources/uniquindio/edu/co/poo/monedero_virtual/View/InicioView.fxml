<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uniquindio.edu.co.poo.monedero_virtual.ViewController.InicioViewController"
            prefWidth="650" prefHeight="450">

    <children>
        <VBox alignment="CENTER" spacing="18"
              AnchorPane.topAnchor="30"
              AnchorPane.bottomAnchor="30"
              AnchorPane.leftAnchor="30"
              AnchorPane.rightAnchor="30">

            <Label text="MONEDERO VIRTUAL"
                   style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

            <Label text="Sistema de puntos y beneficios"/>

            <TextField fx:id="txtNombre"
                       promptText="Nombre completo"
                       maxWidth="300"/>

            <TextField fx:id="txtCorreo"
                       promptText="Correo electrónico"
                       maxWidth="300"/>

            <Button text="Registrarse"
                    onAction="#registrarCliente"
                    maxWidth="200"/>

            <Label fx:id="lblMensaje"/>

        </VBox>
    </children>
</AnchorPane>
