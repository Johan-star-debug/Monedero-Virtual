<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="uniquindio.edu.co.poo.monedero_virtual.ViewController.InicioViewController"
      alignment="CENTER"
      spacing="18"
      prefWidth="800"
      prefHeight="600"
      style="-fx-background-color: #F3F6FB;">

    <padding>
        <Insets top="45" right="60" bottom="45" left="60"/>
    </padding>

    <Label text="MONEDERO VIRTUAL"
           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #183153;"/>

    <Label text="Administra tu dinero, acumula puntos y disfruta beneficios"
           style="-fx-font-size: 15px; -fx-text-fill: #65758B;"/>

    <VBox spacing="15"
          maxWidth="420"
          style="-fx-background-color: white; -fx-background-radius: 15;">

        <padding>
            <Insets top="30" right="35" bottom="30" left="35"/>
        </padding>

        <Label text="Registro de cliente"
               style="-fx-font-size: 21px; -fx-font-weight: bold;"/>

        <Label text="Nombre completo"/>
        <TextField fx:id="txtNombre"
                   promptText="Ingresa tu nombre completo"
                   prefHeight="40"/>

        <Label text="Correo electrónico"/>
        <TextField fx:id="txtCorreo"
                   promptText="ejemplo@correo.com"
                   prefHeight="40"/>

        <Button text="Crear mi cuenta"
                onAction="#registrarCliente"
                maxWidth="Infinity"
                prefHeight="45"
                style="-fx-background-color: #2463A6; -fx-text-fill: white; -fx-font-size: 15px; -fx-background-radius: 8;"/>

        <Label fx:id="lblMensaje"
               wrapText="true"
               style="-fx-text-fill: #2463A6;"/>
    </VBox>

    <Label text="Tu dinero y tus beneficios en un solo lugar"
           style="-fx-text-fill: #8291A5;"/>
</VBox>