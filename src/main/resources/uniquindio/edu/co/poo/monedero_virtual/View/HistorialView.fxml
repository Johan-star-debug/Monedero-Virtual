<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uniquindio.edu.co.poo.monedero_virtual.ViewController.TransaccionViewController"
            prefWidth="900" prefHeight="620"
            style="-fx-background-color: #F3F6FB;">

    <top>
        <VBox spacing="12" style="-fx-background-color: #183153;">
            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>

            <Button text="← Volver al menú"
                    onAction="#volverMenu"
                    prefWidth="160" prefHeight="38"
                    style="-fx-background-color: #315477; -fx-text-fill: white; -fx-background-radius: 8;"/>

            <Label text="TRANSACCIONES"
                   style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Label text="Realiza depósitos, retiros y transferencias"
                   style="-fx-text-fill: #DCE8F5;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="18">
            <padding>
                <Insets top="30" right="45" bottom="30" left="45"/>
            </padding>

            <Label text="Nueva transacción"
                   style="-fx-font-size: 21px; -fx-font-weight: bold;"/>

            <Label text="Tipo de transacción"/>
            <ComboBox fx:id="cmbTipoTransaccion"
                      promptText="Selecciona el tipo"
                      maxWidth="Infinity"/>

            <Label text="Monedero de origen"/>
            <ComboBox fx:id="cmbOrigen"
                      promptText="Selecciona el monedero de origen"
                      maxWidth="Infinity"/>

            <Label text="Monedero de destino (para transferencias)"/>
            <ComboBox fx:id="cmbDestino"
                      promptText="Selecciona el monedero de destino"
                      maxWidth="Infinity"/>

            <Label text="Monto"/>
            <TextField fx:id="txtMonto"
                       promptText="Escribe el monto"/>

            <Button text="Procesar transacción"
                    onAction="#procesarTransaccion"
                    maxWidth="Infinity"
                    prefHeight="42"
                    style="-fx-background-color: #2463A6; -fx-text-fill: white; -fx-background-radius: 8;"/>

            <Label fx:id="lblMensaje" wrapText="true"/>
        </VBox>
    </center>

</BorderPane>