<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uniquindio.edu.co.poo.monedero_virtual.ViewController.HistorialViewController"
            prefWidth="950" prefHeight="650"
            style="-fx-background-color: #F3F6FB;">

    <top>
        <VBox style="-fx-background-color: #183153;">
            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>
            <Label text="HISTORIAL DE MOVIMIENTOS"
                   style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Consulta las operaciones de tus monederos"
                   style="-fx-text-fill: #DCE8F5;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="18">
            <padding>
                <Insets top="30" right="35" bottom="30" left="35"/>
            </padding>

            <Label text="Selecciona un monedero"
                   style="-fx-font-size: 17px; -fx-font-weight: bold;"/>

            <ComboBox fx:id="cmbMonederos"
                      promptText="Selecciona un monedero"
                      maxWidth="Infinity"/>

            <Button text="Consultar movimientos"
                    onAction="#consultarHistorial"
                    maxWidth="Infinity"
                    prefHeight="40"/>

            <Label text="Movimientos registrados"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <TableView fx:id="tablaHistorial"
                       VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"
                                 text="Código" prefWidth="100"/>
                    <TableColumn fx:id="colTipo"
                                 text="Tipo" prefWidth="140"/>
                    <TableColumn fx:id="colMonto"
                                 text="Monto" prefWidth="130"/>
                    <TableColumn fx:id="colFecha"
                                 text="Fecha" prefWidth="180"/>
                    <TableColumn fx:id="colEstado"
                                 text="Estado" prefWidth="130"/>
                </columns>
            </TableView>

            <Label fx:id="lblMensaje"
                   wrapText="true"/>
        </VBox>
    </center>
</BorderPane>