<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="uniquindio.edu.co.poo.monedero_virtual.ViewController.HistorialViewController"
      spacing="15" alignment="CENTER"
      prefWidth="750" prefHeight="500">

    <Label text="HISTORIAL DE TRANSACCIONES"
           style="-fx-font-size: 23px; -fx-font-weight: bold;"/>

    <ComboBox fx:id="cmbMonederos"
              promptText="Seleccionar monedero"/>

    <TableView fx:id="tablaHistorial"
               prefWidth="680" prefHeight="300"/>

    <Button text="Consultar historial"
            onAction="#consultarHistorial"/>

    <Label fx:id="lblMensaje"/>

</VBox>
