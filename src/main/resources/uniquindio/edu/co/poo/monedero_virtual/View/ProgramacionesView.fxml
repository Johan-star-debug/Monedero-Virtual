<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uniquindio.edu.co.poo.monedero_virtual.ViewController.ProgramacionesViewController"
            prefWidth="950" prefHeight="680"
            style="-fx-background-color: #F3F6FB;">

    <top>
        <VBox style="-fx-background-color: #183153;">
            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>
            <Label text="TRANSACCIONES PROGRAMADAS"
                   style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Organiza tus operaciones futuras y recurrentes"
                   style="-fx-text-fill: #DCE8F5;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="25" right="35" bottom="25" left="35"/>
            </padding>

            <Label text="Nueva programación"
                   style="-fx-font-size: 21px; -fx-font-weight: bold;"/>

            <Label text="Tipo de operación"/>
            <ComboBox fx:id="cmbTipo"
                      promptText="Selecciona el tipo"
                      maxWidth="Infinity">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Depósito"/>
                        <String fx:value="Transferencia"/>
                    </FXCollections>
                </items>
            </ComboBox>

            <Label text="Periodicidad"/>
            <ComboBox fx:id="cmbPeriodicidad"
                      promptText="Selecciona la periodicidad"
                      maxWidth="Infinity">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Diaria"/>
                        <String fx:value="Semanal"/>
                        <String fx:value="Mensual"/>
                    </FXCollections>
                </items>
            </ComboBox>

            <Label text="Monedero de origen"/>
            <ComboBox fx:id="cmbOrigen"
                      promptText="Selecciona el monedero"
                      maxWidth="Infinity"/>

            <Label text="Monedero de destino (transferencia)"/>
            <ComboBox fx:id="cmbDestino"
                      promptText="Selecciona el destino"
                      maxWidth="Infinity"/>

            <Label text="Monto"/>
            <TextField fx:id="txtMonto"
                       promptText="Ingresa el monto"/>

            <Label text="Fecha de inicio"/>
            <DatePicker fx:id="fechaProgramada"
                        promptText="Selecciona una fecha"
                        maxWidth="Infinity"/>

            <Button text="Guardar programación"
                    onAction="#programarTransaccion"
                    prefHeight="42"
                    maxWidth="Infinity"/>

            <Label fx:id="lblMensaje"
                   wrapText="true"/>

            <Label text="Mis programaciones"
                   style="-fx-font-size: 19px; -fx-font-weight: bold;"/>

            <ListView fx:id="listaProgramaciones"
                      VBox.vgrow="ALWAYS"
                      prefHeight="130"/>
        </VBox>
    </center>
</BorderPane>